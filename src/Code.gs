  projects.forEach(function (x) { sum.signed += num_(x.value); sum.delivered += num_(x.delivered_value); sum.paid += num_(x.paid); });
  var out = { customer: cu, projects: projects, quotes: quotes, docs: docs, events: ev, sum: sum };
