  readTable_('PROJECTS').forEach(function (x) { addC(x.id, x.customer_id); }); readTable_('QUOTES').forEach(function (q) { addC(q.project_id, q.customer_id); }); readTable_('DOCS').forEach(function (d) { addC(d.project_id, d.customer_id); });
