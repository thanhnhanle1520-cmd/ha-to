  function mark(t, id) { (del[t] = del[t] || {})[String(id)] = 1; }
  function has(t, id) { return !!(del[t] && del[t][String(id)]); }
  function by(t, f, set) { readTable_(t).forEach(function (r) { if (set[String(r[f])]) mark(t, r.id); }); }
  function projects(pids) {
