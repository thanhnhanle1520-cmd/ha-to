// ---------- Cache chia mảnh (gzip + base64, ≤ 90.000 ký tự/mảnh) ----------
function cacheVer_(name) { return CacheService.getScriptCache().get('V:' + name) || '0'; }
// Một lần gọi cache lấy thông tin (meta + phiên bản) của mọi bảng, thay cho 2–3 lần gọi mỗi bảng
function cacheMeta_() {
  if (RT.meta) return RT.meta;
  var keys = ['SCHEMA:' + APP_VERSION];
  Object.keys(TABLES).forEach(function (n) { keys.push('M:' + n, 'V:' + n); });
  var got = {};
  try { got = CacheService.getScriptCache().getAll(keys); } catch (e) { }
  RT.meta = got; return got;
}
function cacheGet_(name) {
  try {
    var c = CacheService.getScriptCache(), mt = cacheMeta_();
    var m = mt['M:' + name];
    if (!m) return null;
    var meta = JSON.parse(m);
    if (meta.v !== (mt['V:' + name] || '0')) return null;      // đã có thay đổi sau khi cache
    var keys = [];
    for (var i = 0; i < meta.n; i++) keys.push('C:' + name + ':' + meta.v + ':' + i);
    var got = c.getAll(keys), s = '';
    for (var k = 0; k < keys.length; k++) { if (got[keys[k]] == null) return null; s += got[keys[k]]; }   // thiếu mảnh = coi như không có cache
    var blob = Utilities.newBlob(Utilities.base64Decode(s), 'application/x-gzip', 'c.gz');
    return JSON.parse(Utilities.ungzip(blob).getDataAsString());
  } catch (e) { return null; }
}
function cachePut_(name, rows, ver) {
  try {
    var c = CacheService.getScriptCache();
    var gz = Utilities.gzip(Utilities.newBlob(JSON.stringify(rows), 'application/octet-stream', 'c.json'));
    var b64 = Utilities.base64Encode(gz.getBytes());
    if (b64.length > 900000) return;                 // quá lớn so với hạn mức cache: bỏ qua, vẫn đọc trực tiếp từ sheet
    var parts = {}, n = 0;
    for (var i = 0; i < b64.length; i += CHUNK) { parts['C:' + name + ':' + ver + ':' + n] = b64.substr(i, CHUNK); n++; }
    var ks = Object.keys(parts);
    for (var j = 0; j < ks.length; j += 20) { var sub = {}; ks.slice(j, j + 20).forEach(function (k) { sub[k] = parts[k]; }); c.putAll(sub, CACHE_TTL + 60); }
    if (cacheVer_(name) !== ver) return;              // có ghi mới trong lúc đọc: không công bố cache cũ
    c.put('M:' + name, JSON.stringify({ v: ver, n: n, t: Date.now() }), CACHE_TTL);
    if (RT.meta) { RT.meta['M:' + name] = JSON.stringify({ v: ver, n: n, t: Date.now() }); RT.meta['V:' + name] = ver; }
  } catch (e) { }
}
function bump_(name) {
  delete RT['T:' + name]; delete RT.idx; delete RT.cat; delete RT.pm; delete RT.rq; delete RT.qib;
  if (RT.meta) delete RT.meta['M:' + name];
  Object.keys(RT).forEach(function (k) { if (k.indexOf('calc:') === 0) delete RT[k]; });
  try { CacheService.getScriptCache().put('V:' + name, String(Date.now()) + Math.floor(Math.random() * 1000), 21600); } catch (e) { }
}
function readTable_(name) {
  var key = 'T:' + name;
  if (RT[key]) return RT[key];
  var rows = cacheGet_(name);
  if (!rows) {
    var ver = cacheVer_(name);
    rows = readSheet_(name);
    cachePut_(name, rows, ver);
  }
  RT[key] = rows;
  return rows;
}

// ---------- Ghi (gọi trong khóa) ----------
// Cột do hệ thống quản lý: khi sửa bản ghi đã có, dữ liệu gửi từ giao diện không được ghi đè các cột này
