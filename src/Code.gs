  if (id) { try { fo = DriveApp.getFolderById(id); fo.getName(); } catch (e) { fo = null; } }
  if (!fo) { fo = childFolder_(rootFolder_(), 'Xuất file'); try { c.put('XF', fo.getId(), 21600); } catch (e) { } }
