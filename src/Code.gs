  costs: { table: 'COSTS', prefix: null, req: ['project_id', 'type'], date: 'date' },
  advances: { table: 'ADVANCES', prefix: 'TU', req: ['project_id', 'doc_id'], date: 'date' },
  payments: { table: 'PAYMENTS', prefix: 'TT', req: ['project_id', 'doc_id'], date: 'date' },
  warranties: { table: 'WARRANTIES', prefix: 'BH', req: ['project_id'], date: 'start_date' },
  certs: { table: 'CERTS', prefix: 'XX', req: ['project_id'], date: 'issue_date' }
};
function saveSimple_(u, key, p) {
  var def = SIMPLE[key], r = p.rec, table = def.table;
  def.req.forEach(function (f) { if (!r[f]) throw new Error('Thiếu thông tin: ' + f); });
  var rec = readTable_(table).filter(function (c) { return c.id === r.id; })[0], isNew = !rec, out = keepSystemCols_(Object.assign({}, rec || {}, r), rec, ['id', 'code', 'created_by', 'created_at']);
  out[def.date] = today0_(out[def.date]);
  if (key === 'costs') { out.payer = out.payer === 'KHACH' ? 'KHACH' : 'HATO'; out.amount = num_(out.amount); if (out.amount < 0) throw new Error('Số tiền âm.'); }
  if (key === 'advances') { out.vat = out.vat === 'CO' ? 'CO' : 'KHONG'; out.pct = num_(out.pct); out.amount = round_(out.amount); out.term_index = num_(out.term_index); chk_(out.amount >= 0, 'Số tiền âm.'); chk_(out.pct >= 0 && out.pct <= 100, 'Tỷ lệ tạm ứng phải từ 0 đến 100%.'); }
  if (key === 'payments') { out.kind = out.kind === 'PHAI_TRA' ? 'PHAI_TRA' : 'PHAI_THU'; out.amount = round_(out.amount); out.term_index = num_(out.term_index); out.pct = num_(out.pct); chk_(out.amount >= 0, 'Số tiền âm.'); }
  if (key === 'warranties') out.items = (out.items || []).filter(function (x) { return x && String(x.name || '').trim(); });
  if (key === 'certs') {
    out.site = String(out.site || '');
    out.items = (out.items || []).filter(function (x) { return x && String(x.name || '').trim(); }).map(function (x) {
      return { name: String(x.name), spec: String(x.spec || ''), model: String(x.model || ''), qty: num_(x.qty), unit: String(x.unit || ''),
        params: (x.params || []).filter(function (q) { return q && (String(q.desc || '').trim() || String(q.value || '').trim()); }).map(function (q) { return { desc: String(q.desc || ''), value: String(q.value || ''), result: String(q.result || ''), note: String(q.note || '') }; }) };
    });
  }
  if (isNew && key === 'certs' && out.delivery_id && index_().delById[out.delivery_id]) {   // số phiếu xuất xưởng = XX + số BBGH (GH-2026-004 → XX-2026-004)
    var base = 'XX' + String(index_().delById[out.delivery_id].code).replace(/^[A-Za-z]+/, ''), taken = {};
    readTable_('CERTS').forEach(function (x) { taken[x.code] = 1; });
    var cand = base, n = 1; while (taken[cand]) cand = base + '-' + (++n);
    out.id = newId_('XX'); out.code = cand; out.lot = cand; out.created_by = u.email; out.created_at = now_();
  } else
  if (isNew) { out.id = newId_(def.prefix || 'CP'); if (def.prefix) out.code = nextCode_(def.prefix, true); out.created_by = u.email; out.created_at = now_(); }
  upsert_(table, out);
  audit_(u, isNew ? 'Tạo' : 'Sửa', table, out.id, out.project_id, (out.code || out.type || '') + ' ' + (out.amount || ''));
  return out;
}

ACTIONS.save = function (u, p) {
  var key = p.table;
  var isNew = !(p.rec && p.rec.id);
  need_(u, key, isNew ? 'create' : 'edit');
  return withLock_(function () {
    RT = { user: RT.user, ss: RT.ss };
    if (key === 'customers') return saveCustomer_(u, p);
    if (key === 'projects') return saveProject_(u, p);
    if (key === 'quotes') return saveQuote_(u, p);
    if (key === 'docs') return saveDoc_(u, p);
    if (key === 'deliveries') return saveDelivery_(u, p);
    if (SIMPLE[key]) return saveSimple_(u, key, p);
    throw new Error('Bảng không hợp lệ.');
  });
};

ACTIONS.reviseQuote = function (u, p) {
  need_(u, 'quotes', 'create');
  return withLock_(function () {
    RT = { user: RT.user, ss: RT.ss };
    var q = readTable_('QUOTES').filter(function (x) { return x.id === p.id; })[0];
    if (!q) throw new Error('Không tìm thấy báo giá.');
    var maxV = Math.max.apply(null, readTable_('QUOTES').filter(function (x) { return x.code === q.code; }).map(function (x) { return x.version; }));
    var nq = Object.assign({}, q, { status: 'Nháp', id: newId_('Q'), version: maxV + 1, date: today_(), converted_to: '', created_by: u.email, created_at: now_(), updated_at: now_() });
    var items = readTable_('QUOTE_ITEMS').filter(function (x) { return x.quote_id === q.id; }).sort(byLine_).map(function (x) { return Object.assign({}, x, { id: newId_('QI'), quote_id: nq.id }); });
    upsert_('QUOTES', nq); appendMany_('QUOTE_ITEMS', items);
    audit_(u, 'Revise', 'QUOTES', nq.id, nq.project_id, nq.code + ' v' + nq.version);
    return { id: nq.id, version: nq.version };
  });
};

ACTIONS.convertQuote = function (u, p) {
  need_(u, 'docs', 'create');
  return withLock_(function () {
    RT = { user: RT.user, ss: RT.ss };
    var q = readTable_('QUOTES').filter(function (x) { return x.id === p.quote_id; })[0];
    if (!q) throw new Error('Không tìm thấy báo giá.');
    var type = p.type;
    var items = readTable_('QUOTE_ITEMS').filter(function (x) { return x.quote_id === q.id; }).sort(byLine_).map(function (x) {
      var net = round_(num_(x.price) * (1 - num_(x.disc_pct) / 100));
      return { code: x.code, name: x.name, model: x.model, brand: x.brand, origin: x.origin, unit: x.unit, qty: x.qty, price_offer: x.price, price: net, cost: '', cost_list: x.cost, source: 'QUOTE', note: x.note, spec: x.spec, vat_line: lineVat_(x, q) };
    });
    var bal = null;
    if (p.balance) {      // bản 38: cân chi phí vào đơn giá khi chuyển; báo giá gốc giữ nguyên dòng chi phí
      bal = costBalance_(quoteLines_(q.id), p.balance === true ? {} : p.balance);
      items = bal.lines.map(function (x) { return { code: x.code, name: x.name, model: x.model, brand: x.brand, origin: x.origin, unit: x.unit, qty: x.qty, price_offer: x.price, price: num_(x.price), cost: '', cost_list: x.cost, source: 'QUOTE', note: x.note, spec: x.spec, vat_line: lineVat_(x, q) }; });
    }
    var dsc = discIntoItems_(q, items, p.disc_round);      // bản 40: giảm giá tổng trừ vào đơn giá
    items = dsc.items;
    var qc = custOfQuote_(q), hdOfC = (index_().docsByProject[q.project_id] || []).filter(function (d) { return d.type === 'HD' && custOfDoc_(d) === qc; })[0];
    var rec = { type: type, project_id: q.project_id, customer_id: qc, parent_id: p.parent_id || (hdOfC ? hdOfC.id : ''), source_quote_id: q.id, vat_pct: q.vat_pct, sign_date: today_(), terms: type === 'HD' ? [{ name: 'Đợt 1', pct: 100, days: 30 }] : [], doc_no: p.doc_no || '' };
    var res = saveDoc_(u, { rec: rec, items: items });
    var q2 = Object.assign({}, q, { converted_to: (q.converted_to ? q.converted_to + ', ' : '') + res.doc.code, updated_at: now_() });
    upsert_('QUOTES', q2);
    var pr = readTable_('PROJECTS').filter(function (x) { return x.id === q.project_id; })[0];
    if (pr && pr.status === 'Đang chào giá') upsert_('PROJECTS', Object.assign({}, pr, { status: 'Đang thực hiện', updated_at: now_() }));
    audit_(u, 'Chuyển báo giá', 'DOCS', res.doc.id, q.project_id, q.code + ' → ' + res.doc.code + (bal ? ' (cân ' + money_(bal.cost_total) + ' chi phí vào đơn giá)' : ''));
    return { doc: res.doc, balanced: bal ? { cost_total: bal.cost_total, diff: bal.diff } : null, discount: dsc.disc ? { amount: dsc.disc, diff: dsc.diff } : null };
  });
};

/* ===== Cân chi phí vào đơn giá (bản 38) =====
   Dòng chi phí (vận chuyển, chi phí ngoài…) được chia vào đơn giá các dòng hàng rồi bỏ khỏi bảng.
   o.cost: chỉ số dòng chi phí (bỏ trống → tự nhận: ghi chú "cân vào đơn giá", ĐVT "Chuyến", tên bắt đầu "Chi phí");
   o.target: chỉ số dòng nhận phần cân (bỏ trống → mọi dòng còn lại); o.mode: 'value' (theo thành tiền) | 'qty' (theo số lượng);
   o.round: làm tròn đơn giá mới (1 | 100 | 1000). Phần lệch do làm tròn dồn vào 1 dòng để tổng gần nhất với trước. Giá vốn không đổi. */
function isCostLine_(x) {
  var s = function (v) { return String(v || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').trim(); };
  return /can vao don gia/.test(s(x.note)) || s(x.unit) === 'chuyen' || /^chi phi/.test(s(x.name));
}
function costBalance_(lines, o) {
  o = o || {};
  var R = [1, 100, 1000].indexOf(num_(o.round)) >= 0 ? num_(o.round) : 100, mode = o.mode === 'qty' ? 'qty' : o.mode === 'manual' ? 'manual' : 'value';
  var net = function (x) { return round_(num_(x.price) * (1 - num_(x.disc_pct) / 100)); };
  var AMT = o.amount != null;      // bản 40: cộng / trừ một số tiền cho sẵn (giảm giá tổng = số âm), không cần dòng chi phí
  var costIdx = AMT ? [] : Array.isArray(o.cost) && o.cost.length ? o.cost.map(Number) : lines.map(function (x, i) { return isCostLine_(x) ? i : -1; }).filter(function (i) { return i >= 0; });
  var isCost = {}; costIdx.forEach(function (i) { if (lines[i]) isCost[i] = 1; });
  var tg = (Array.isArray(o.target) && o.target.length ? o.target.map(Number) : lines.map(function (x, i) { return i; })).filter(function (i) { return lines[i] && !isCost[i] && num_(lines[i].qty) > 0; });
  if (!AMT && !Object.keys(isCost).length) throw new Error('Chưa có dòng chi phí cần cân (đánh dấu dòng chi phí, hoặc ghi chú "Cân vào đơn giá").');
  if (!tg.length) throw new Error('Không còn dòng hàng nào để nhận phần chi phí.');
  var C = 0; Object.keys(isCost).forEach(function (i) { C += round_(num_(lines[i].qty) * net(lines[i])); });
  var before = 0; lines.forEach(function (x) { before += round_(num_(x.qty) * net(x)); });
  if (AMT) { C = round_(o.amount); before += C; }
  if (mode === 'manual') {     // tự nhập đơn giá mới từng dòng; phần chưa cân hết giữ nguyên là "còn lại", không tự dồn
    var mp = o.prices || {}, npm = {};
    tg.forEach(function (i) { var v = mp[i] != null && mp[i] !== '' ? round_(mp[i]) : net(lines[i]); if (v < 0) throw new Error('Đơn giá mới của "' + lines[i].name + '" không được âm.'); npm[i] = v; });
    var aft = 0; lines.forEach(function (x, i) { if (!isCost[i]) aft += round_(num_(x.qty) * (npm[i] != null ? npm[i] : net(x))); });
    var outM = []; lines.forEach(function (x, i) { if (isCost[i]) return; outM.push(npm[i] != null ? Object.assign({}, x, { price: npm[i], disc_pct: 0 }) : x); });
    return { lines: outM, rows: tg.map(function (i) { var o0 = net(lines[i]); return { idx: i, name: lines[i].name, unit: lines[i].unit, qty: num_(lines[i].qty), old: o0, add: npm[i] - o0, price: npm[i] }; }),
      cost_idx: Object.keys(isCost).map(Number), cost_total: C, before: before, after: aft, diff: before - aft, round: R, mode: mode,
      costs: Object.keys(isCost).map(function (i) { var x = lines[i]; return { idx: +i, name: x.name, amount: round_(num_(x.qty) * net(x)) }; }) };
  }
  var w = tg.map(function (i) { return mode === 'qty' ? num_(lines[i].qty) : num_(lines[i].qty) * net(lines[i]); }), W = w.reduce(function (a, b) { return a + b; }, 0);
  if (!(W > 0)) throw new Error(mode === 'qty' ? 'Các dòng nhận phần cân chưa có số lượng.' : 'Các dòng nhận phần cân chưa có đơn giá (thử chia theo số lượng).');
  var np = {}; tg.forEach(function (i, k) { var q = num_(lines[i].qty); np[i] = Math.max(0, Math.round((net(lines[i]) + C * w[k] / W / q) / R) * R); });
  var after = function () { var s = 0; lines.forEach(function (x, i) { if (!isCost[i]) s += round_(num_(x.qty) * (np[i] != null ? np[i] : net(x))); }); return s; };
  var diff = before - after();
  if (diff) {        // dồn phần lệch: chọn dòng làm tổng sát nhất, ưu tiên dòng giá trị lớn
    var best = null;
    tg.forEach(function (i) { var q = num_(lines[i].qty), k = Math.round(diff / (q * R)), res = diff - k * q * R, val = q * np[i]; if (np[i] + k * R <= 0) return; if (!best || Math.abs(res) < Math.abs(best.res) || (Math.abs(res) === Math.abs(best.res) && val > best.val)) best = { i: i, k: k, res: res, val: val }; });
    if (best && best.k) np[best.i] += best.k * R;
    diff = before - after();
  }
  var rows = tg.map(function (i) { var x = lines[i], o0 = net(x); return { idx: i, name: x.name, unit: x.unit, qty: num_(x.qty), old: o0, add: np[i] - o0, price: np[i] }; });
  var out = []; lines.forEach(function (x, i) { if (isCost[i]) return; out.push(np[i] != null ? Object.assign({}, x, { price: np[i], disc_pct: 0, note: x.note }) : x); });
  return { lines: out, rows: rows, cost_idx: Object.keys(isCost).map(Number), cost_total: C, before: before, after: before - diff, diff: diff, round: R, mode: mode,
    costs: Object.keys(isCost).map(function (i) { var x = lines[i]; return { idx: +i, name: x.name, amount: round_(num_(x.qty) * net(x)) }; }) };
}
/* Giảm giá tổng của báo giá → trừ thẳng vào đơn giá các dòng (khi chuyển / cập nhật HĐ, PO), tổng gần như khớp */
function discIntoItems_(q, items, R) {
  var gross = 0; items.forEach(function (x) { gross += round_(num_(x.qty) * num_(x.price)); });
  var D = discAmt_(q, gross); if (!D) return { items: items, disc: 0, diff: 0 };
  var r = costBalance_(items, { amount: -D, mode: 'value', round: R || 100 });
  return { items: r.lines, disc: D, diff: r.diff };
}
function quoteLines_(qid) { return readTable_('QUOTE_ITEMS').filter(function (x) { return x.quote_id === qid; }).sort(byLine_); }
ACTIONS.costBalancePreview = function (u, p) {      // trả về các dòng (để chọn) + kết quả cân; cân chưa được thì trả lỗi kèm theo, không ném lỗi
  need_(u, 'quotes', 'view');
  var lines = quoteLines_(p.quote_id); if (!lines.length) throw new Error('Báo giá chưa có dòng hàng.');
  var out = { lines: lines.map(function (x, i) { return { idx: i, name: x.name, unit: x.unit, qty: num_(x.qty), price: round_(num_(x.price) * (1 - num_(x.disc_pct) / 100)), note: x.note || '', auto_cost: isCostLine_(x) }; }) };
  try {
    var r = costBalance_(lines, p.opt || {});
    ['rows', 'costs', 'cost_total', 'before', 'after', 'diff', 'round', 'mode'].forEach(function (k) { out[k] = r[k]; });
  } catch (e) { out.error = String((e && e.message) || e); }
  return out;
};
ACTIONS.costBalanceQuote = function (u, p) {     // tạo phiên bản mới (.R) của báo giá với đơn giá đã cân, bỏ dòng chi phí
  need_(u, 'quotes', 'create');
  return withLock_(function () {
    RT = { user: RT.user, ss: RT.ss };
    var q = readTable_('QUOTES').filter(function (x) { return x.id === p.quote_id; })[0]; if (!q) throw new Error('Không tìm thấy báo giá.');
    var r = costBalance_(quoteLines_(q.id), p.opt || {});
    var maxV = Math.max.apply(null, readTable_('QUOTES').filter(function (x) { return x.code === q.code; }).map(function (x) { return x.version; }));
    var nq = Object.assign({}, q, { status: 'Nháp', id: newId_('Q'), version: maxV + 1, date: today_(), converted_to: '', created_by: u.email, created_at: now_(), updated_at: now_() });
    var items = r.lines.map(function (x, k) { var o = Object.assign({}, x, { id: newId_('QI'), quote_id: nq.id, line_no: k + 1 }); if (num_(o.cost) > 0 && x.price !== undefined) o.coef = Math.round(num_(o.price) / num_(o.cost) * 1000) / 1000; return o; });
    upsert_('QUOTES', nq); appendMany_('QUOTE_ITEMS', items);
    audit_(u, 'Cân chi phí', 'QUOTES', nq.id, nq.project_id, quoteNo_(nq) + ' ← ' + quoteNo_(q) + ': cân ' + money_(r.cost_total) + ' vào ' + r.rows.length + ' dòng');
    return { id: nq.id, version: nq.version, code: nq.code, diff: r.diff };
  });
};

function docLockReason_(d) {      // văn bản đã phát sinh giao hàng / mua hàng / phụ lục ký → không cập nhật thẳng từ báo giá
  var idx = index_();
  var dl = Object.keys(idx.delItems).some(function (did) { var x = idx.delById[did]; return x && x.status !== 'HUY' && (idx.delItems[did] || []).some(function (di) { return di.doc_id === d.id; }); });
  if (dl) return 'đã có phiếu giao hàng';
  var pu = mapBy_(readTable_('PURCHASES'), 'id');
  if (readTable_('PURCHASE_ITEMS').some(function (x) { return x.doc_id === d.id && pu[x.purchase_id] && pu[x.purchase_id].status !== 'HUY'; })) return 'đã có đơn mua hàng';
  if ((idx.docsByProject[d.project_id] || []).some(function (x) { return x.type === 'PLHD' && x.parent_id === d.id && plhdOn_(x); })) return 'đã có phụ lục đã ký';
  return '';
}
ACTIONS.syncDocFromQuote = function (u, p) {    // Cập nhật PO / HĐ / PL đã chuyển theo báo giá (dòng hàng, giá, VAT)
  need_(u, 'docs', 'edit');
  return withLock_(function () {
    RT = { user: RT.user, ss: RT.ss };
    var q = readTable_('QUOTES').filter(function (x) { return x.id === p.quote_id; })[0];
    if (!q) throw new Error('Không tìm thấy báo giá.');
    var d = index_().docById[p.doc_id];
    if (!d) throw new Error('Không tìm thấy văn bản.');
    var fam = {}; readTable_('QUOTES').forEach(function (x) { if (x.code === q.code) fam[x.id] = 1; });
    if (!fam[d.source_quote_id]) throw new Error('Văn bản ' + d.code + ' không được chuyển từ báo giá ' + q.code + '.');
    var why = docLockReason_(d);
    if (why) throw new Error('Văn bản ' + d.code + ' ' + why + ' — không cập nhật thẳng được. Hãy lập Phụ lục HĐ cho phần thay đổi.');
    var old = (index_().itemsByDoc[d.id] || []).slice().sort(byLine_);
    var items = readTable_('QUOTE_ITEMS').filter(function (x) { return x.quote_id === q.id; }).sort(byLine_).map(function (x, i) {
      var net = round_(num_(x.price) * (1 - num_(x.disc_pct) / 100)), o = old[i], same = o && String(o.name || '') === String(x.name || '');
      return { id: o ? o.id : '', ref_item_id: o ? o.ref_item_id || '' : '', code: x.code, name: x.name, model: x.model, brand: x.brand, origin: x.origin, unit: x.unit, qty: x.qty, price_offer: x.price, price: net,
        cost: same ? o.cost : '', cost_src: same ? o.cost_src || '' : '', cost_list: x.cost, source: 'QUOTE', note: x.note, spec: x.spec, vat_line: lineVat_(x, q) };
    });
    if (!items.length) throw new Error('Báo giá chưa có dòng hàng.');
    items = discIntoItems_(q, items).items;        // bản 40: giảm giá tổng trừ vào đơn giá
    var res = saveDoc_(u, { rec: Object.assign({}, d, { vat_pct: q.vat_pct, source_quote_id: q.id }), items: items });
    if ((', ' + (q.converted_to || '') + ',').indexOf(', ' + d.code + ',') < 0) upsert_('QUOTES', Object.assign({}, q, { converted_to: (q.converted_to ? q.converted_to + ', ' : '') + d.code, updated_at: now_() }));
    audit_(u, 'Cập nhật theo báo giá', 'DOCS', d.id, d.project_id, q.code + ' v' + q.version + ' → ' + d.code);
    return { doc: res.doc };
  });
};
ACTIONS.remove = function (u, p) {
  var key = p.table;
  need_(u, key, 'edit');
  return withLock_(function () {
    RT = { user: RT.user, ss: RT.ss };
    var idx = index_(), id = p.id, table = LISTABLE[key];
    if (!table) throw new Error('Bảng không hợp lệ.');
    var rec = readTable_(table).filter(function (x) { return x.id === id; })[0];
    if (!rec) throw new Error('Không tìm thấy bản ghi.');
    var pid = rec.project_id || '';
    if (key === 'customers') {
      if (readTable_('PROJECTS').some(function (x) { return x.customer_id === id; })) throw new Error('Khách hàng đã có dự án, không xóa được. Hãy đổi trạng thái sang Ngừng.');
    } else if (key === 'projects') {
      if (MGR.indexOf(u.role) < 0) throw new Error('Chỉ Quản trị / Giám đốc được xóa dự án.');
      if ((idx.docsByProject[id] || []).length || (idx.delByProject[id] || []).length || readTable_('QUOTES').some(function (x) { return x.project_id === id; })) throw new Error('Dự án đã có dữ liệu. Hãy chuyển trạng thái sang Hủy thay vì xóa.');
    } else if (key === 'quotes') {
      // Báo giá đã chốt (bản 23): xóa được khi người dùng xác nhận — HĐ/PO giữ nguyên dòng hàng, chỉ bỏ liên kết nguồn báo giá
      if (rec.converted_to && !p.force) throw new Error('Báo giá đã chuyển thành văn bản (' + rec.converted_to + '). Cần xác nhận để xóa.');
      readTable_('DOCS').filter(function (d) { return d.source_quote_id === id; }).forEach(function (d) { upsert_('DOCS', Object.assign({}, d, { source_quote_id: '' })); });
      replaceChildren_('QUOTE_ITEMS', 'quote_id', id, []);
    } else if (key === 'docs') {
      if (rec.type === 'HD' && (idx.docsByProject[rec.project_id] || []).some(function (d) { return d.type === 'PLHD' && (d.parent_id === rec.id || !d.parent_id); })) throw new Error('Hợp đồng đã có PLHD, hãy xóa PLHD trước.');
      var usedDel = Object.keys(idx.delItems).some(function (k) { return (idx.delItems[k] || []).some(function (x) { return x.doc_id === id; }); });
      if (usedDel) throw new Error('Văn bản đã có phiếu giao hàng, không xóa được.');
      if (rec.type === 'PLHD' && plhdOn_(rec)) throw new Error('Phụ lục đã ký: chuyển trạng thái "Hủy" trước (hệ thống kiểm tra số đã giao), sau đó mới xóa.');
      if (readTable_('PURCHASE_ITEMS').some(function (x) { return x.doc_id === id; })) throw new Error('Văn bản đã có đơn mua gắn dòng hàng, không xóa được.');
      if (readTable_('ADVANCES').concat(readTable_('PAYMENTS')).some(function (x) { return x.doc_id === id; })) throw new Error('Văn bản đã có tạm ứng/thanh toán, hãy xóa các khoản đó trước.');
      replaceChildren_('DOC_ITEMS', 'doc_id', id, []);
    } else if (key === 'deliveries') {
      replaceChildren_('DELIVERY_ITEMS', 'delivery_id', id, []);
    } else if (key === 'files') {
      try { var m = String(rec.url).match(/[-\w]{25,}/); if (m) DriveApp.getFileById(m[0]).setTrashed(true); } catch (e) { }
    }
    if (key === 'docs' || key === 'quotes' || key === 'deliveries' || key === 'warranties') {      // tệp đính kèm không mất: chuyển thành tệp chung của dự án (giữ loại tệp)
      readTable_('FILES').filter(function (x) { return x.doc_id === id || x.ref_id === id; }).forEach(function (x) { upsert_('FILES', Object.assign({}, x, { kind: fileKind_(x), doc_id: x.doc_id === id ? '' : x.doc_id, ref_type: x.ref_id === id ? '' : x.ref_type, ref_id: x.ref_id === id ? '' : x.ref_id })); });
    }
    removeByKey_(table, id);
    audit_(u, 'Xóa', table, id, pid, rec.code || rec.name || '');
    return true;
  });
};

// ---------- Dashboard ----------
// Tổng quan: lưu kết quả 5 phút, tự bỏ khi bất kỳ bảng nghiệp vụ nào thay đổi (so phiên bản bảng) → lần mở lại máy chủ trả gần như tức thì
ACTIONS.dashboard = function (u, p) {
  need_(u, 'dashboard', 'view');
  var key = null;
  try {
    var mt = cacheMeta_(), sig = Object.keys(TABLES).filter(function (n) { return n !== 'AUDIT' && n !== 'ERRLOG' && n !== 'FILES' && n !== 'TASKS' && n !== 'PRICEHIST' && n !== 'RFQS'; }).map(function (n) { return mt['V:' + n] || '0'; }).join('.');
    var raw = JSON.stringify([p.from || '', p.to || '', p.customer_id || '', p.project_id || '', canCost_(u) ? 1 : 0, APP_VERSION, sig]);
    key = 'D:' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, raw)).slice(0, 22);
    var hit = CacheService.getScriptCache().get(key);
    if (hit) return JSON.parse(hit);
  } catch (e) { key = null; }
  var out = dashboardCalc_(u, p);
  if (key) { try { var js = JSON.stringify(out); if (js.length < 90000) CacheService.getScriptCache().put(key, js, 300); } catch (e) { } }
  return out;
};
function dashboardCalc_(u, p) {
  var from = p.from || '', to = p.to || '';
  function inR(d) { d = String(d || '').slice(0, 10); if (!d) return !from && !to; return (!from || d >= from) && (!to || d <= to); }
  var projects = readTable_('PROJECTS').filter(function (x) { return (!p.customer_id || x.customer_id === p.customer_id) && (!p.project_id || x.id === p.project_id); });
  var pids = {}; projects.forEach(function (x) { pids[x.id] = x; });
  var custs = mapBy_(readTable_('CUSTOMERS'), 'id');
  var qs = readTable_('QUOTES').filter(function (q) { return pids[q.project_id] && inR(q.date); });
  var qi = groupBy_(readTable_('QUOTE_ITEMS'), 'quote_id');
  var latest = {}; qs.forEach(function (q) { if (!latest[q.code] || q.version > latest[q.code].version) latest[q.code] = q; });
  var months = {};
  function mo(d) { var k = String(d).slice(0, 7); return months[k] = months[k] || { m: k, quote: 0, converted: 0 }; }
  var quoteTotal = 0;
  Object.keys(latest).forEach(function (k) { var q = latest[k], t = quoteTotals_(q, qi[q.id] || []).sub; quoteTotal += t; mo(q.date).quote += t; });
  var conv = 0;
  projects.forEach(function (pr) {
    var c = calcProject_(pr.id);
    Object.keys(c.docs).forEach(function (id) { var e = c.docs[id], d = e.doc, dt = d.sign_date || d.created_at; if (c.basis === 'PO' && d.type !== 'PO') return; if (inR(dt)) { conv += e.value; mo(dt).converted += e.value; } });
  });
  var sentN = 0, wonN = 0, byCode = {};
  readTable_('QUOTES').forEach(function (q) { if (pids[q.project_id] && inR(q.date)) (byCode[q.code] = byCode[q.code] || []).push(q); });
  Object.keys(byCode).forEach(function (k) {
    var won = byCode[k].some(function (q) { return q.converted_to; }), sent = won || byCode[k].some(function (q) { return q.status === 'Đã gửi' || q.status === 'Không chốt'; });
    if (sent) sentN++; if (won) wonN++;
  });
  var dprojects = projects.filter(function (x) { return x.kind !== 'LE'; });
  var byStatus = {}; dprojects.forEach(function (x) { byStatus[x.status] = (byStatus[x.status] || 0) + 1; });
  var active = dprojects.filter(function (x) { return x.status === 'Đang thực hiện'; });
  var tv = 0, tdv = 0;
  var prog = active.map(function (x) { var c = calcProject_(x.id); tv += c.value; tdv += c.delivered_value; return { id: x.id, code: x.code, name: x.name, pct: c.delivered_pct }; }).sort(function (a, b) { return a.pct - b.pct; }).slice(0, 8);
  var qCount = Object.keys(latest).length, hdN = 0, poN = 0, plN = 0, hdV = 0, poV = 0;
  projects.forEach(function (pr) {
    var c = calcProject_(pr.id);
    Object.keys(c.docs).forEach(function (id) { var e = c.docs[id], d = e.doc, dt = d.sign_date || d.created_at; if (!inR(dt)) return; if (d.type === 'HD') { hdN++; hdV += e.value; } else if (d.type === 'PO') { poN++; poV += e.value; } else plN++; });
  });
  var out = {
    kpi: { quote_total: quoteTotal, converted_value: conv, quote_sent: sentN, quote_won: wonN, close_rate: sentN > 0 ? wonN / sentN : 0, quote_count: qCount, hd_count: hdN, po_count: poN, plhd_count: plN, hd_value: hdV, po_value: poV, active_projects: active.length, delivered_pct_all: tv > 0 ? tdv / tv : 0 },
    projectsByStatus: Object.keys(byStatus).map(function (k) { return { status: k, count: byStatus[k] }; }),
    deliveryProgress: prog,
    active: active.map(function (x) { return { id: x.id, code: x.code, name: x.name, customer_name: (custs[x.customer_id] || {}).name || '' }; })
  };
  if (canCost_(u)) {
    out.pnl = projects.filter(function (pr) {
      if (!from && !to) return true;
      return (index_().docsByProject[pr.id] || []).some(function (d) { return inR(d.sign_date || d.created_at); });
    }).map(function (pr) {
      var c = calcProject_(pr.id);
      return { id: pr.id, code: pr.code, name: pr.name, customer_name: (custs[pr.customer_id] || {}).name || '', value: c.value, cost_goods: c.cost_goods, cost_hato: c.cost_hato, profit: c.profit, margin: c.margin, ratio: c.ratio, revenue: c.revenue, cogs: c.cogs, profit_real: c.profit_real, margin_real: c.margin_real };
    }).filter(function (x) { return x.value || x.cost_hato; }).sort(function (a, b) { return b.profit - a.profit; });
  }
  return out;
}


