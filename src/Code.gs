  var u = {}; Object.keys(TABLES).forEach(function (n) { if (TABLES[n].indexOf('code') < 0 || n === 'COUNTERS') return; try { readTable_(n).forEach(function (r) { var c = String(r.code || ''); if (c.indexOf(pre) === 0) u[c] = 1; }); } catch (e) { } });
